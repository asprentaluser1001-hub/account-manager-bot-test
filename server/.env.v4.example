# V4 isolated developer preview. Keep separate from every production service/database/bot.
NODE_ENV=production
PORT=4500
V3_PREVIEW=true
SANDBOX_MODE=true
PAYMENT_MODE=mock
DB_PATH=/opt/flingroulette-v4/server/data/v4-preview.db
ADMIN_PASSWORD=replace-with-a-unique-preview-password-12-chars-min
JWT_SECRET=replace-with-a-unique-preview-secret-32-chars-min
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
PUBLIC_CHECKOUT_URL=https://REPLACE_WITH_V4_PREVIEW_HOST/checkout
TELEGRAM_MINI_APP_URL=https://REPLACE_WITH_V4_PREVIEW_HOST/miniapp
IMB_API_TOKEN=
