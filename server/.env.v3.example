# FlingRoulette V3 developer preview only.
# Copy to /opt/flingroulette-v3/server/.env.v3 on the preview VPS.
# Never reuse V2 values or production secrets.

NODE_ENV=production
PORT=4400
V3_PREVIEW=true
SANDBOX_MODE=true
PAYMENT_MODE=mock

ADMIN_PASSWORD=replace-with-a-preview-only-password-12-chars-min
JWT_SECRET=replace-with-a-preview-only-secret-32-chars-min
DB_PATH=/opt/flingroulette-v3/server/data/v3-preview.db

# Use a separate test bot only. Leave empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
PUBLIC_CHECKOUT_URL=https://REPLACE_WITH_V3_PREVIEW_HOST/checkout

# Must remain empty in V3 preview. Live IMB is blocked by server startup checks.
IMB_API_TOKEN=
