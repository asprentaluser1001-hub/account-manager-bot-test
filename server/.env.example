# Copy this to .env and fill in your values.

# Port the server listens on
PORT=4000

# The single admin password used to log into the dashboard
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-secret-string

# Path to the SQLite database file (created automatically if missing)
DB_PATH=./test.db

# Use true for sample-only testing. Set false only for a live install where
# you are authorised to manage the accounts.
SANDBOX_MODE=true
# Optional Telegram bot. Do not paste the token into chat.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the admin, never a public username.
TELEGRAM_ADMIN_ID=
# Public HTTPS URL ending in /checkout. When set, bot plan buttons open this page.
PUBLIC_CHECKOUT_URL=https://your-domain.example/checkout
# Preview only: enable a mock Mini App on @Booking_testfling_bot. Leave blank in production.
# Set only on the isolated preview service with V3_PREVIEW=true and PAYMENT_MODE=mock.
MINI_APP_TEST_URL=
TELEGRAM_TEST_BOT_USERNAME=
# Optional IMB Payment API token. Keep this on the server only; never put it in client code or GitHub.
IMB_API_TOKEN=
